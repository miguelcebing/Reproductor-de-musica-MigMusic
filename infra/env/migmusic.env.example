# MigMusic - production environment variables (names only, NO real values).
# Copied to /etc/migmusic/migmusic.env on the server (root:migmusic, mode 0640).
# Never commit a filled-in copy of this file.

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO

# Same-origin setup: Nginx serves the SPA and proxies /api to Gunicorn, so the
# browser never cross-origin. These still drive the CORS middleware.
FRONTEND_ORIGIN=https://CHANGE_ME_DOMAIN
ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN

# Host header allow-list. Without it FastAPI answers 400 to every request
# once the domain is no longer *.onrender.com.
TRUSTED_HOSTS=CHANGE_ME_DOMAIN,localhost,127.0.0.1

# --- Spotify (backend only) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://CHANGE_ME_DOMAIN/api/auth/callback
SESSION_SECRET_KEY=
OAUTH_STATE_MAX_AGE=900

# --- Database (PostgreSQL on Neon) ---
DATABASE_URL=

# --- Keep-alive ---
# Empty on AWS: the server is always on, so the Render self-ping stays off.
RENDER_BACKEND_URL=

# --- Playback ---
SKIP_SECONDS=5

# --- YouTube Music ---
YOUTUBE_MUSIC_ENABLED=true
YOUTUBE_MUSIC_LANGUAGE=en
YOUTUBE_MUSIC_TIMEOUT_SECONDS=8

# --- Security hardening ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=65536
