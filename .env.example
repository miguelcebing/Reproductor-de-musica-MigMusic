# ============================================================
# MigMusic - environment variables (names only, NO real values)
# Copy to `.env` (backend) and fill in locally. Never commit `.env`.
# ============================================================

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173

# --- Spotify (backend only) ---
# Client ID is public; Client Secret must NEVER reach the frontend or the repo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
SESSION_SECRET_KEY=

# --- Database (PostgreSQL on Neon) ---
DATABASE_URL=

# --- CORS / proxy ---
# Vercel rewrites /api/* to the Render backend; keep x-vercel-enable-rewrite-caching: 0
RENDER_BACKEND_URL=
