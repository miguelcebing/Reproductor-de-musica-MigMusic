# ============================================================
# MigMusic - environment variables (names only, NO real values)
# Copy to `.env` (backend) and fill in locally. Never commit `.env`.
# ============================================================

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173

# --- Spotify (backend only) ---
# Client ID is public; Client Secret must NEVER reach the frontend or the repo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
SESSION_SECRET_KEY=
# Seconds a Spotify login may stay unfinished (2FA + consent screen).
# The signed `state` carries the pending login, so only the cookie ages out.
OAUTH_STATE_MAX_AGE=900

# --- Database (PostgreSQL on Neon) ---
# Non-empty selects SqlPlaylistRepository (production); empty = in-memory adapter.
DATABASE_URL=
# Optional: run the SQL contract tests against your own server.
# When unset they boot an embedded PostgreSQL (pgserver dev dependency).
# TEST_DATABASE_URL=

# --- Keep-alive / proxy ---
# Render service URL self-pinged by the keep-alive loop (health check).
# Vercel rewrites /api/* to the Render backend; keep x-vercel-enable-rewrite-caching: 0
RENDER_BACKEND_URL=

# --- Spotify scopes (optional override) ---
# Space-separated. MUST stay commented: an empty value would replace the
# default scope list and break the consent screen.
# SPOTIFY_SCOPES=streaming user-read-email user-read-private user-read-playback-state user-modify-playback-state playlist-read-private user-library-read user-follow-read

# --- Playback ---
# PLAYER-001/002: exact number of seconds moved by the skip buttons (default 5)
SKIP_SECONDS=5
